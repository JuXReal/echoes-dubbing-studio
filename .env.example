# ==============================================================================
# Echoes Dubbing Studio — Environment Configuration (.env.example)
# Copy this file to .env and configure your local Bring-Your-Own-Data (BYOD) paths.
# ==============================================================================

# Optional Frontier LLM API Keys (Leave empty to use built-in Phonetic Director / Local Ollama)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# ==============================================================================
# Frontier-AI Repair & Translation (Step 1 & Step 5 escalation)
# SECURITY: This .env file is git-ignored. NEVER paste keys into config.yaml
# or commit them to GitHub. Manage these via the Web Studio settings panel.
# ==============================================================================
# Provider: openai | openrouter | google | deepseek | ollama | none
AI_PROVIDER="openai"
AI_API_KEY=""
AI_BASE_URL=""          # Optional override (default depends on provider)
AI_MODEL=""             # Optional override (default depends on provider)
AI_ENABLED="true"       # Master switch for AI repair
AI_REPAIR_AFTER_FAILURES="3"

# Optional Local Ollama Configuration
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:7b"

# ==============================================================================
# Bring Your Own Data (BYOD) — Local Paths & Optional Custom Endpoints
# ==============================================================================
# Local Game Addon / Voiceover Pack Directories (for wow_chatty adapter mode)
WOW_ADDONS_DIR="/path/to/Game/Interface/AddOns"
WOW_SAVED_VARS="/path/to/Game/SavedVariables/ChattyLittleNpc.lua"

# Optional User-Defined Quest Text Endpoint Templates (Disabled by default)
# Example: "https://your-local-or-custom-db.example.com/quest={quest_id}"
QUEST_TEXT_PROVIDER_URL=""
QUEST_EN_PROVIDER_URL=""

# Optional Player Character Placeholders (for stripping recorded player names)
WOW_PLAYER_NAME="Hero"
WOW_PLAYER_CLASS="Paladin"
WOW_PLAYER_RACE="Human"
